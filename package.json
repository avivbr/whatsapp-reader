{
  "name": "whatsapp-reader",
  "version": "0.3.0",
  "description": "Read-only, offline CLI for the WhatsApp for Mac local database. Never contacts WhatsApp.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/avivbr/whatsapp-reader.git"
  },
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin"
  ],
  "bin": {
    "wa": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node --no-warnings scripts/build.mjs",
    "test": "node --no-warnings --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build && git diff --quiet dist || (echo 'dist/ is stale - commit the rebuild' && exit 1)"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^24.0.0"
  }
}
