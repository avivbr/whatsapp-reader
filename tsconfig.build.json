{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "declaration": false,
    "sourceMap": true,
    // Source imports use explicit .ts specifiers, which Node's type stripping
    // requires. On emit these must become .js; TS 5.7 rewrites them for us.
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts"]
}
